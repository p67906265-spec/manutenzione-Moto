<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/itemPart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:id="@+id/itemCost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="17sp" />
        <ImageButton android:id="@+id/itemMenu" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/ic_more" android:tint="@color/white" android:contentDescription="Azioni" />
    </LinearLayout>
    <TextView android:id="@+id/itemInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="5dp" />
    <ProgressBar android:id="@+id/itemProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:progressTint="@color/cyan" android:progressBackgroundTint="#223747" android:visibility="gone" />
</LinearLayout>
