<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/navy" android:padding="16dp" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MANUTENZIONE MOTO" android:textColor="@color/white" android:textStyle="bold" android:textSize="24sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Il diario della tua moto" android:textColor="@color/cyan" android:textSize="14sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_settings" android:contentDescription="Impostazioni" android:background="@drawable/bg_circle_button" android:padding="12dp" android:tint="@color/white" />
    </LinearLayout>

    <FrameLayout android:id="@+id/heroPanel" android:layout_width="match_parent" android:layout_height="170dp" android:background="@drawable/bg_hero" android:clipToOutline="true" android:layout_marginBottom="8dp">
        <ImageView android:id="@+id/bikeBackgroundImage" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/moto_africa_twin" android:scaleType="centerCrop" android:alpha="0.58" android:contentDescription="@null" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_overlay" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
            <TextView android:text="MOTO ATTIVA" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.14" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/activeBikeText" android:text="La mia moto" android:textColor="@color/white" android:textStyle="bold" android:textSize="25sp" android:shadowColor="#CC000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="CHILOMETRAGGIO" android:textColor="@color/muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/currentKmText" android:text="0 km" android:textColor="@color/white" android:textStyle="bold" android:textSize="25sp" android:shadowColor="#CC000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <Button android:id="@+id/updateKmButton" android:text="AGGIORNA" android:layout_width="wrap_content" android:layout_height="46dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <RadioGroup android:id="@+id/sectionGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
        <RadioButton android:id="@+id/sectionHistory" android:text="Manutenzioni" android:checked="true" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/sectionDeadlines" android:text="Scadenze" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

    <RadioGroup android:id="@+id/filterGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="6dp">
        <RadioButton android:id="@+id/filterAll" android:text="Tutti" android:checked="true" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/filterShop" android:text="Officina" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/filterMe" android:text="Io" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Nessun intervento registrato\nPremi + per iniziare" android:textColor="@color/muted" android:textSize="16sp" />
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:visibility="gone" />

    <Button android:id="@+id/addButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="＋  NUOVO INTERVENTO" android:textStyle="bold" android:textSize="16sp" />
</LinearLayout>
