<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/navy" android:padding="16dp" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/white" android:textStyle="bold" android:textSize="24sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/subtitle" android:textColor="@color/cyan" android:textSize="14sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_settings" android:contentDescription="Impostazioni" android:background="@drawable/bg_circle_button" android:padding="12dp" android:tint="@color/white" />
    </LinearLayout>

    <FrameLayout android:id="@+id/heroPanel" android:layout_width="match_parent" android:layout_height="170dp" android:background="@drawable/bg_hero" android:clipToOutline="true" android:layout_marginBottom="8dp">
        <ImageView android:id="@+id/bikeBackgroundImage" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/moto_africa_twin" android:scaleType="centerCrop" android:alpha="0.58" android:contentDescription="@null" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_overlay" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
            <TextView android:text="@string/active_bike" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.14" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/activeBikeText" android:text="La mia moto" android:textColor="@color/white" android:textStyle="bold" android:textSize="25sp" android:shadowColor="#CC000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="@string/mileage" android:textColor="@color/muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <it.paolofree.manutenzionemoto.HudOdometerView android:id="@+id/currentKmText" android:text="0 km" android:textColor="@color/white" android:textStyle="bold" android:textSize="22sp" android:fontFamily="sans-serif-condensed" android:layout_width="150dp" android:layout_height="90dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateKmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="118dp"
                    android:text="@string/update"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    app:backgroundTint="#99162735"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/cyan"
                    app:strokeWidth="1dp"
                    app:rippleColor="#55FF40B4" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <RadioGroup android:id="@+id/sectionGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
        <RadioButton android:id="@+id/sectionHistory" android:text="@string/maintenance" android:checked="true" android:textColor="@color/white" android:button="@null" android:background="@drawable/bg_segment" android:padding="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/sectionDeadlines" android:text="@string/deadlines" android:textColor="@color/white" android:button="@null" android:background="@drawable/bg_segment" android:padding="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

    <RadioGroup android:id="@+id/filterGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="6dp">
        <RadioButton android:id="@+id/filterAll" android:text="@string/all" android:checked="true" android:textColor="@color/white" android:button="@null" android:background="@drawable/bg_segment" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/filterShop" android:text="@string/workshop" android:textColor="@color/white" android:button="@null" android:background="@drawable/bg_segment" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <RadioButton android:id="@+id/filterMe" android:text="@string/me" android:textColor="@color/white" android:button="@null" android:background="@drawable/bg_segment" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RadioGroup>

    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/empty_maintenance" android:textColor="@color/muted" android:textSize="16sp" />
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="6dp"
        android:text="@string/new_maintenance"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:letterSpacing="0.08"
        app:backgroundTint="#99162735"
        app:cornerRadius="28dp"
        app:strokeColor="@color/cyan"
        app:strokeWidth="1dp"
        app:rippleColor="#55FF40B4" />
</LinearLayout>
