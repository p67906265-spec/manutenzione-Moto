<resources>
    <style name="Theme.ManutenzioneMoto" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:alertDialogTheme">@style/Theme.ManutenzioneMoto.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.ManutenzioneMoto.Dialog</item>
        <item name="android:buttonStyle">@style/Widget.ManutenzioneMoto.Button</item>
        <item name="buttonStyle">@style/Widget.ManutenzioneMoto.Button</item>
    </style>

    <style name="Theme.ManutenzioneMoto.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorAccent">@color/cyan</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ManutenzioneMoto.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ManutenzioneMoto.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ManutenzioneMoto.DialogButton</item>
    </style>

    <style name="Widget.ManutenzioneMoto.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.ManutenzioneMoto.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
